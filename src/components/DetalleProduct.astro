<section class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow-md space-y-6">

  <!-- Título -->
  <h2 class="text-xl font-semibold text-gray-800">
    Configura tu producto
  </h2>

  <!-- Color -->
  <div>
    <p class="text-sm text-gray-500 mb-2">Color</p>
    <div class="flex gap-2">
      <button class="px-4 py-2 rounded-full border border-black bg-black text-white text-sm">
        Negro
      </button>
      <button class="px-4 py-2 rounded-full border border-gray-300 text-gray-700 text-sm hover:border-black">
        Blanco
      </button>
      <button class="px-4 py-2 rounded-full border border-gray-300 text-gray-700 text-sm hover:border-black">
        Azul
      </button>
    </div>
  </div>

  <!-- Almacenamiento -->
  <div>
    <p class="text-sm text-gray-500 mb-2">Almacenamiento</p>
    <div class="flex gap-2">
      <button class="px-4 py-2 rounded-full border border-black bg-black text-white text-sm">
        128 GB
      </button>
      <button class="px-4 py-2 rounded-full border border-gray-300 text-gray-700 text-sm hover:border-black">
        256 GB
      </button>
      <button class="px-4 py-2 rounded-full border border-gray-300 text-gray-700 text-sm hover:border-black">
        512 GB
      </button>
    </div>
  </div>

  <!-- Cantidad -->
  <div>
    <p class="text-sm text-gray-500 mb-2">Cantidad</p>
    <div class="flex items-center gap-3">
      <button class="w-10 h-10 flex items-center justify-center border rounded-lg text-gray-700 hover:border-black">
        -
      </button>
      <span class="text-gray-800 font-medium">1</span>
      <button class="w-10 h-10 flex items-center justify-center border rounded-lg text-gray-700 hover:border-black">
        +
      </button>
    </div>
  </div>

  <!-- Botón -->
  <button class="w-full bg-black text-white py-3 rounded-xl text-sm font-medium hover:opacity-90 transition">
    Agregar al carrito
  </button>

</section>