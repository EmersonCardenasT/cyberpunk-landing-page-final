---
import TabletPremiun from "../assets/img/tablet_premium.webp";
import AudioPro from "../assets/img/audifonos.webp";
import Gaming from "../assets/img/gaming.webp";
import Smartwaths from "../assets/img/smartwaths.webp";
import ServicioTecnico from "../assets/img/servicio_tecnico.webp";
import ServicioTecnicoCompu from "../assets/img/servicio_tecnico_compu.webp";
import EcosistemaApple from "../assets/img/ecosistema_apple.webp";
---

<!-- GALERIA -->
<section id="gallery" class="py-24 px-6 bg-white dark:bg-slate-950">
  <div class="max-w-[1600px] mx-auto">
    <div class="text-center mb-16">
      <p class="text-primary font-bold tracking-[0.3em] uppercase text-xs mb-3">
        Ecosistema Completo
      </p>
      <h2
        class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        Explora la línea
      </h2>
    </div>

    <div
      class="grid grid-cols-2 md:grid-cols-4 md:grid-rows-3 gap-4 h-auto md:h-[900px]"
    >
      <div
        class="col-span-2 md:col-span-2 md:row-span-2 relative group overflow-hidden rounded-[0.5rem] bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800"
      >
        <!-- Imagen -->
        <img
          alt="Premium Tablet"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={TabletPremiun.src}
        />

        <!-- Gradiente Apple -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute bottom-8 left-8">
          <p class="text-[10px] uppercase tracking-widest text-white/80 mb-1">
            Productividad
          </p>
          <h3 class="text-xl font-bold text-white">
            Tablets de última generación
          </h3>
        </div>
      </div>

      <div
        class="col-span-1 md:col-span-1 relative group overflow-hidden rounded-[0.5rem] bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800"
      >
        <!-- Imagen -->
        <img
          alt="Audio"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={AudioPro.src}
        />

        <!-- Gradiente -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute bottom-6 left-6">
          <h3 class="text-sm font-bold uppercase tracking-tight text-white">
            Audio Pro
          </h3>
        </div>
      </div>

      <div
        class="col-span-1 md:col-span-1 relative group overflow-hidden rounded-[0.5rem] bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800"
      >
        <!-- Imagen -->
        <img
          alt="Gaming"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={Gaming.src}
        />

        <!-- Gradiente -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute bottom-6 left-6">
          <h3 class="text-sm font-bold uppercase tracking-tight text-white">
            Gaming Zone
          </h3>
        </div>
      </div>

      <div
        class="col-span-2 md:col-span-2 relative group overflow-hidden rounded-[0.5rem] bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30"
      >
        <!-- Imagen -->
        <img
          alt="Watch"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={Smartwaths.src}
        />

        <!-- Gradiente tipo Apple -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute bottom-6 left-6">
          <p class="text-[10px] uppercase tracking-widest text-white/80 mb-1">
            Wearables
          </p>
          <h3 class="text-lg font-bold text-white">Relojes Inteligentes</h3>
        </div>
      </div>

      <div
        class="col-span-1 md:col-span-1 relative group overflow-hidden rounded-[0.5rem] bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800"
      >
        <!-- Imagen -->
        <img
          alt="Camera"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={ServicioTecnico.src}
        />

        <!-- Gradiente -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute bottom-6 left-6">
          <h3 class="text-sm font-bold text-white">Servicio Técnico</h3>
        </div>
      </div>

      <div
        class="col-span-1 md:col-span-1 relative group overflow-hidden rounded-[0.5rem] bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700"
      >
        <!-- Imagen -->
        <img
          alt="Console"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={ServicioTecnicoCompu.src}
        />

        <!-- Gradiente -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute bottom-6 left-6">
          <h3 class="text-sm font-bold text-white">Ordenadores</h3>
        </div>
      </div>

      <div
        class="col-span-2 md:col-span-2 relative group overflow-hidden rounded-[0.5rem] bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30"
      >
        <!-- Imagen -->
        <img
          alt="Accessories"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          src={EcosistemaApple.src}
        />

        <!-- Gradiente -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"
        >
        </div>

        <!-- Texto -->
        <div class="absolute top-8 right-8 text-right">
          <p class="text-[10px] uppercase tracking-widest text-white/80 mb-1">
            Accesorios
          </p>
          <h3 class="text-lg font-bold text-white">Ecosistema Completo</h3>
        </div>
      </div>
    </div>
  </div>
</section>
