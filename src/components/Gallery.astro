---
import TabletPremiun from "../assets/img/tablet_premium.webp";
import AudioPro from "../assets/img/audifonos.webp";
import Gaming from "../assets/img/gaming.webp";
import Smartwaths from "../assets/img/smartwaths.webp";
import ServicioTecnico from "../assets/img/servicio_tecnico.webp";
import ServicioTecnicoCompu from "../assets/img/servicio_tecnico_compu.webp";
import EcosistemaApple from "../assets/img/ecosistema_apple.webp";
---

<section id="gallery" class="py-24 px-6 bg-white dark:bg-slate-950">
  <div class="max-w-[1600px] mx-auto">
    <div class="text-center mb-16">
      <p class="text-primary font-bold tracking-[0.3em] uppercase text-xs mb-3">
        Ecosistema Completo
      </p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        Explora la línea
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4
                auto-rows-[160px] sm:auto-rows-[180px] md:auto-rows-[200px] lg:auto-rows-[240px]">

      <!-- Tablet Premium — 2x2 en desktop, full width en móvil -->
      <div class="col-span-2 row-span-1 sm:row-span-2 md:col-span-2 md:row-span-2
                  relative group overflow-hidden rounded-[0.5rem]
                  bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
        <img
          alt="Premium Tablet"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={TabletPremiun.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute bottom-8 left-8">
          <p class="text-[10px] uppercase tracking-widest text-white/80 mb-1">Productividad</p>
          <h3 class="text-xl font-bold text-white">Tablets de última generación</h3>
        </div>
      </div>

      <!-- Audio Pro -->
      <div class="col-span-1 relative group overflow-hidden rounded-[0.5rem]
                  bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
        <img
          alt="Audio"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={AudioPro.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6">
          <h3 class="text-xs md:text-sm font-bold uppercase tracking-tight text-white">Audio Pro</h3>
        </div>
      </div>

      <!-- Gaming -->
      <div class="col-span-1 relative group overflow-hidden rounded-[0.5rem]
                  bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
        <img
          alt="Gaming"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={Gaming.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6">
          <h3 class="text-xs md:text-sm font-bold uppercase tracking-tight text-white">Gaming Zone</h3>
        </div>
      </div>

      <!-- Smartwatches — ancho completo en móvil, 2 cols en desktop -->
      <div class="col-span-2 md:col-span-2 relative group overflow-hidden rounded-[0.5rem]
                  bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30">
        <img
          alt="Watch"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={Smartwaths.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6">
          <p class="text-[10px] uppercase tracking-widest text-white/80 mb-1">Wearables</p>
          <h3 class="text-base md:text-lg font-bold text-white">Relojes Inteligentes</h3>
        </div>
      </div>

      <!-- Servicio Técnico -->
      <div class="col-span-1 relative group overflow-hidden rounded-[0.5rem]
                  bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
        <img
          alt="Servicio Técnico"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={ServicioTecnico.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6">
          <h3 class="text-xs md:text-sm font-bold text-white">Servicio Técnico</h3>
        </div>
      </div>

      <!-- Ordenadores -->
      <div class="col-span-1 relative group overflow-hidden rounded-[0.5rem]
                  bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
        <img
          alt="Ordenadores"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src={ServicioTecnicoCompu.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6">
          <h3 class="text-xs md:text-sm font-bold text-white">Ordenadores</h3>
        </div>
      </div>

      <!-- Ecosistema Apple — ancho completo en móvil, 2 cols en desktop -->
      <div class="col-span-2 md:col-span-2 relative group overflow-hidden rounded-[0.5rem]
                  bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30">
        <img
          alt="Ecosistema Apple"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          src={EcosistemaApple.src}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition"></div>
        <div class="absolute top-6 right-6 md:top-8 md:right-8 text-right">
          <p class="text-[10px] uppercase tracking-widest text-white/80 mb-1">Accesorios</p>
          <h3 class="text-base md:text-lg font-bold text-white">Ecosistema Completo</h3>
        </div>
      </div>

    </div>
  </div>
</section>