---
import LogoApple from "../assets/img/svg_logo_apple.svg";
import LogoSamsung from "../assets/img/svg_logo_samsung.svg";
import LogoXiaomi from "../assets/img/svg_logo_xiaomi.svg";
import LogoHuawei from "../assets/img/svg_logo_huawei.svg";
import LogoMoto from "../assets/img/svg_logo_moto.svg";
import LogoVivo from "../assets/img/svg_logo_vivo.svg";
import LogoOneplus from "../assets/img/svg_logo_oneplus.svg";

// Datos centralizados — añade o quita marcas aquí
const BRANDS = [
  { src: LogoApple.src, alt: "Apple", label: "Apple", color: "#555555" },
  { src: LogoSamsung.src, alt: "Samsung", label: "Samsung", color: "#1428A0" },
  { src: LogoXiaomi.src, alt: "Xiaomi", label: "Xiaomi", color: "#FF6900" },
  { src: LogoHuawei.src, alt: "Huawei", label: "Huawei", color: "#CF0A2C" },
  { src: LogoMoto.src, alt: "Motorola", label: "Motorola", color: "#0053A0" },
  { src: LogoVivo.src, alt: "Vivo", label: "Vivo", color: "#415FFF" },
  { src: LogoOneplus.src, alt: "OnePlus", label: "OnePlus", color: "#F5010C" },
];

// Triplicamos para garantizar loop sin cortes visibles
const TRACK = [...BRANDS, ...BRANDS, ...BRANDS];
---

<style>
  /* carrusel infinito */
  @keyframes brands-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .brands-track {
    animation: brands-scroll 30s linear infinite;
    width: max-content;
  }

  .brands-wrapper:hover .brands-track {
    animation-play-state: paused;
  }

  /* logo gris */
  .brand-logo {
    width: 72px;
    height: 42px;
    object-fit: contain;
    filter: grayscale(1) opacity(0.45);
    transition: all 0.3s ease;
  }

  /* hover color */
  .brand-item:hover .brand-logo {
    filter: grayscale(0) opacity(1);
    transform: scale(1.08);
  }

  /* label */
  .brand-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(148 163 184 / 0.6);
    transition: color 0.3s ease;
  }

  .brand-item:hover .brand-label {
    color: rgb(30 64 175); /* azul */
  }
</style>

<!-- ════════════════════════════════════════════════════
  SECCIÓN CTA + CARRUSEL DE MARCAS
════════════════════════════════════════════════════ -->
<section class="py-24 px-6 relative overflow-hidden">
  <!-- CTA -->
  <div class="max-w-4xl mx-auto text-center relative z-10">
    <h2
      class="text-4xl md:text-5xl font-extrabold mb-8
               bg-gradient-to-r from-blue-600 to-blue-600 bg-clip-text text-transparent"
    >
      ¿LISTO PARA ACTUALIZAR TU MUNDO?
    </h2>
    <p
      class="text-slate-600 dark:text-slate-400 mb-10 text-lg max-w-2xl mx-auto"
    >
      Únete hoy a los miles que ya están moldeando el futuro con tecnología
      Cyberpunk.
    </p>
    <a
      href="https://wa.me/51927854195?text=Hola%20¡Me%20interesa%20comprar%20un%20celular%20en%20Cyberpunk!"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-blue-600 text-white px-12 py-5 rounded-full
             font-bold shadow-lg transition-all duration-300
             hover:scale-105 hover:shadow-blue-500/30 hover:shadow-xl"
    >
      COMPRAR AHORA
    </a>
  </div>

  <!-- Fondo decorativo -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-blue-600/5 via-blue-500/10 to-transparent
              dark:from-blue-400/10 dark:via-blue-500/20 blur-[120px] pointer-events-none"
  >
  </div>

  <!-- ── Separador ── -->
  <div
    class="mt-20 mb-10 flex items-center justify-center gap-3 max-w-xs mx-auto"
  >
    <div
      class="h-px flex-1 bg-gradient-to-r from-transparent to-slate-300 dark:to-slate-700"
    >
    </div>
    <span
      class="text-[10px] font-bold tracking-[0.25em] uppercase text-slate-400 dark:text-slate-500"
    >
      Marcas oficiales
    </span>
    <div
      class="h-px flex-1 bg-gradient-to-l from-transparent to-slate-300 dark:to-slate-700"
    >
    </div>
  </div>

  <!-- ── Carrusel infinito ── -->
  <div class="brands-wrapper relative -mx-6 overflow-hidden">
    <div class="brands-mask-left"></div>
    <div class="brands-mask-right"></div>

    <div class="brands-track flex items-center gap-6 sm:gap-10 lg:gap-20 py-6 px-6">
      {
        TRACK.map((brand, i) => (
          <div
            class="brand-item flex flex-col items-center gap-2 shrink-0"
            aria-hidden={i >= BRANDS.length ? "true" : "false"}
          >
            <img
              src={brand.src}
              alt={brand.alt}
              class="brand-logo w-10 h-6 sm:w-14 sm:h-8 lg:w-20 lg:h-10"
              loading="lazy"
              draggable="false"
            />

            <span class="text-[9px] sm:text-[11px] lg:text-xs brand-label">{brand.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
