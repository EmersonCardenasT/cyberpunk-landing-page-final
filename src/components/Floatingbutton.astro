<script>
  const tab = document.getElementById("contactTab")!;
  const modal = document.getElementById("contactModal")!;
  const overlay = document.getElementById("modalOverlay")!;
  const closeBtn = document.getElementById("modalClose")!;

  const openModal = () => {
    modal.classList.add("is-open");
    overlay.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    tab.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const closeModal = () => {
    modal.classList.remove("is-open");
    overlay.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    tab.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  tab.addEventListener("click", openModal);
  tab.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") openModal();
  });
  closeBtn.addEventListener("click", closeModal);
  overlay.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });

  // --- Métodos de pago: click para expandir/colapsar el detalle ---
  const paymentButtons = document.querySelectorAll<HTMLButtonElement>("[data-payment-toggle]");

  paymentButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.paymentToggle;
      const panel = document.querySelector<HTMLElement>(`[data-payment-panel="${id}"]`);
      if (!panel) return;

      const isOpen = btn.getAttribute("aria-expanded") === "true";

      // Cierra cualquier otro panel abierto (solo uno visible a la vez)
      paymentButtons.forEach((other) => {
        if (other !== btn) other.setAttribute("aria-expanded", "false");
      });
      document.querySelectorAll<HTMLElement>("[data-payment-panel]").forEach((p) => {
        if (p !== panel) p.hidden = true;
      });

      panel.hidden = isOpen;
      btn.setAttribute("aria-expanded", String(!isOpen));
    });
  });

  // --- Copiar al portapapeles ---
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        btn.classList.add("is-copied");
        setTimeout(() => btn.classList.remove("is-copied"), 1200);
      } catch {
        // Clipboard API no disponible (ej. http sin TLS); no bloquea el flujo.
      }
    });
  });
</script>