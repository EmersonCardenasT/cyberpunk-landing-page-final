---
import Modelo3D from "./Modelo3D.jsx";
---

<section
  id="reparacion"
  class="relative py-24 md:py-32 overflow-hidden"
>
  <div class="max-w-[1800px] mx-auto px-6 lg:px-12">

    <div class="grid lg:grid-cols-4 gap-10 items-center">

      <!-- MODELO 3D -->
      <div
        class="lg:col-span-3 h-[550px] md:h-[700px] lg:h-[900px] relative rounded-[2rem]"
      >

        <!-- Borde degradado (fade to transparent) -->
        <div
          class="absolute -inset-px rounded-[2rem] pointer-events-none z-30"
          style="
            padding: 1px;
            background: linear-gradient(
              135deg,
              rgba(34,211,238,0.55) 0%,
              rgba(34,211,238,0) 30%,
              rgba(34,211,238,0) 70%,
              rgba(34,211,238,0.35) 100%
            );
            -webkit-mask:
              linear-gradient(#fff 0 0) content-box,
              linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
          "
        ></div>

        <!-- Desvanecido lateral -->
        <div
          class="absolute inset-0 pointer-events-none z-20"
          style="
            mask-image: linear-gradient(
              to right,
              transparent 0%,
              black 8%,
              black 92%,
              transparent 100%
            );
            -webkit-mask-image: linear-gradient(
              to right,
              transparent 0%,
              black 8%,
              black 92%,
              transparent 100%
            );
          "
        ></div>

        <!-- Desvanecido superior e inferior -->
        <div
          class="absolute inset-0 pointer-events-none z-20"
          style="
            mask-image: linear-gradient(
              to bottom,
              transparent 0%,
              black 10%,
              black 90%,
              transparent 100%
            );
            -webkit-mask-image: linear-gradient(
              to bottom,
              transparent 0%,
              black 10%,
              black 90%,
              transparent 100%
            );
          "
        ></div>

        <!-- Badge flotante: Micro soldadura -->
        <div
          class="floating-badge floating-badge--slow absolute left-[6%] bottom-[10%] z-40 flex items-center gap-3 rounded-2xl border border-white/10 bg-slate-900/70 px-4 py-3 backdrop-blur-md shadow-[0_8px_30px_rgba(0,0,0,0.35)]"
        >
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-500/15">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-cyan-400">
              <rect x="4" y="9" width="16" height="10" rx="2"></rect>
              <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
              <circle cx="12" cy="14" r="1.5"></circle>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-white leading-none">Micro soldadura</div>
            <div class="mt-1 text-xs text-slate-400 leading-none">Nivel EPROM</div>
          </div>
        </div>

        <!-- Badge flotante: Diagnóstico avanzado -->
        <div
          class="floating-badge absolute right-[4%] top-[14%] z-40 flex items-center gap-3 rounded-2xl border border-white/10 bg-slate-900/70 px-4 py-3 backdrop-blur-md shadow-[0_8px_30px_rgba(0,0,0,0.35)]"
        >
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-500/15">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-cyan-400">
              <path d="M3 12h4l3 8 4-16 3 8h4"></path>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-white leading-none">Diagnóstico avanzado</div>
            <div class="mt-1 text-xs text-slate-400 leading-none">Sensores originales</div>
          </div>
        </div>

        <Modelo3D client:only="react" />
      </div>

      <!-- TEXTO -->
      <div class="lg:col-span-1">

        <span
          class="inline-flex items-center rounded-full border border-cyan-500/20 bg-cyan-500/10 px-4 py-2 text-sm font-medium text-cyan-400"
        >
          Reparación Premium
        </span>

        <h2
          class="mt-6 text-4xl md:text-5xl font-bold leading-tight"
        >
          Tu smartphone en manos expertas
        </h2>

        <p
          class="mt-6 text-lg text-slate-400 leading-relaxed"
        >
          Reparamos dispositivos premium con herramientas profesionales,
          diagnóstico avanzado y componentes de alta calidad para devolver el
          máximo rendimiento a tu equipo.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">

          <span class="rounded-full bg-white/5 px-4 py-2 text-sm">
            ✓ Pantallas OLED
          </span>

          <span class="rounded-full bg-white/5 px-4 py-2 text-sm">
            ✓ Baterías premium
          </span>

          <span class="rounded-full bg-white/5 px-4 py-2 text-sm">
            ✓ Face ID
          </span>

          <span class="rounded-full bg-white/5 px-4 py-2 text-sm">
            ✓ Micro soldadura
          </span>

          <span class="rounded-full bg-white/5 px-4 py-2 text-sm">
            ✓ Diagnóstico avanzado
          </span>

          <span class="rounded-full bg-white/5 px-4 py-2 text-sm">
            ✓ Garantía incluida
          </span>

        </div>

        <div class="mt-10 grid grid-cols-2 gap-4">

          <div class="rounded-2xl border border-white/10 p-5">
            <div class="text-3xl font-bold text-cyan-400">
              +200
            </div>
            <div class="text-sm text-slate-400">
              Equipos reparados
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 p-5">
            <div class="text-3xl font-bold text-cyan-400">
              98%
            </div>
            <div class="text-sm text-slate-400">
              Satisfacción
            </div>
          </div>

        </div>

        <a
          href="https://wa.me/51927854195?text=Hola%20%C2%A1Quiero%20m%C3%A1s%20informaci%C3%B3n!"
          target="_blank"
          class="
            mt-10
            inline-flex
            items-center
            rounded-xl
            bg-cyan-500
            px-6
            py-4
            font-semibold
            text-black
            transition
            hover:scale-105
          "
        >
          Solicitar diagnóstico
        </a>

      </div>

    </div>

  </div>
</section>

<style>
  .floating-badge {
    animation: float 4s ease-in-out infinite;
  }
  .floating-badge--slow {
    animation-duration: 5s;
    animation-delay: -1.5s;
  }
  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
</style>